<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="NewModalNamespace" constructor="NewModal" version="0.0.1" display-name-key="NewModal" description-key="NewModal description" control-type="standard" >
    <!--external-service-usage node declares whether this 3rd party PCF control is using external service or not, if yes, this control will be considered as premium and please also add the external domain it is using.
    If it is not using any external service, please set the enabled="false" and DO NOT add any domain below. The "enabled" will be false by default.
    Example1:
      <external-service-usage enabled="true">
        <domain>www.Microsoft.com</domain>
      </external-service-usage>
    Example2:
      <external-service-usage enabled="false">
      </external-service-usage>
    -->
    <external-service-usage enabled="false">
      <!--UNCOMMENT TO ADD EXTERNAL DOMAINS
      <domain></domain>
      <domain></domain>
      -->
    </external-service-usage>
    <!-- property node identifies a specific, configurable piece of data that the control expects from CDS -->
    <property name="NewModal" display-name-key="Property_Display_Key" description-key="All Style Text Field" of-type-group="text" usage="bound" required="true" />
    <property name="style" display-name-key="Style" description-key="Style for the field"
              of-type="SingleLine.TextArea" usage="input" required="false"
              default-value="background-color: white;" />
    <property name="class" display-name-key="Class" description-key="Class for the field"
              of-type="SingleLine.TextArea" usage="input" required="false" default-value="pcfDefault" />
    <type-group name="text">
      <type>SingleLine.TextArea</type>
      <type>SingleLine.Text</type>
    </type-group>


    <property name="optionsInput" display-name-key="OptionSet" description-key="OptionSet" of-type="OptionSet" usage="bound" required="true" />
    <property name="componentHeight" display-name-key="Component Height" description-key="Set the height of the dropdown component" of-type="Enum" usage="input" required="false" default-value="Short">
      <value name="Tall" display-name-key="Tall" description-key="Standard height dropdown">Tall</value>
      <value name="Short" display-name-key="Short" description-key="Compact height dropdown (75% of standard)">Short</value>
    </property>
    <property name="icon" display-name-key="Icon" description-key="The Fluent UI icon to display (https://learn.microsoft.com/en-us/windows/apps/design/style/segoe-fluent-icons-font)" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="sortBy" display-name-key="Sort by" description-key="Sort by" of-type="Enum" usage="input" required="false" default-value="Value">
      <value name="Value" display-name-key="Value" description-key="Sort by the value of the options" default="true">Value</value>
      <value name="Text" display-name-key="Text" description-key="Sort by the text of the options, corresponding to the user language">Text</value>
    </property>
    <property name="hideHiddenOptions" display-name-key="Hide hidden choice options" description-key="Hide options marked as hidden in the option set" of-type="TwoOptions" usage="input" required="false" default-value="true" />
    <property name="showColorIcon" display-name-key="Show option color icon" description-key="Display color icon on the left of each option" of-type="TwoOptions" usage="input" required="false" default-value="true" />
    <property name="iconColorOverride" display-name-key="Color Override" description-key="Override colors with custom hex color (e.g. #FF0000 or FF0000)" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="showColorBorder" display-name-key="Show option color border" description-key="Display colored border around the dropdown control" of-type="TwoOptions" usage="input" required="false" default-value="false" />
    <property name="showColorBackground" display-name-key="Show option color background" description-key="Display selected option color as background" of-type="Enum" usage="input" required="false" default-value="No">
      <value name="No" display-name-key="No" description-key="No color background">No</value>
      <value name="Lighter" display-name-key="Lighter color" description-key="Lighter version of the option color">Lighter</value>
      <value name="Full" display-name-key="Full color" description-key="Full option color">Full</value>
    </property>
    <property name="makeFontBold" display-name-key="Make font bold" description-key="Display dropdown text in bold font weight" of-type="TwoOptions" usage="input" required="false" default-value="false" />
    <property name="useExternalValueForIcon" display-name-key="Use external value for icon" description-key="When enabled, the External Value of the choice will be used as the icon name for that choice option" of-type="TwoOptions" usage="input" required="false" default-value="false" />

    <!--
      Property node's of-type attribute can be of-type-group attribute.
      Example:
      <type-group name="numbers">
        <type>Whole.None</type>
        <type>Currency</type>
        <type>FP</type>
        <type>Decimal</type>
      </type-group>
      <property name="sampleProperty" display-name-key="Property_Display_Key" description-key="Property_Desc_Key" of-type-group="numbers" usage="bound" required="true" />
    -->
    <resources>
      <code path="index.ts" order="1"/>
      <css path="css/NewModal.css" order="2" />
      <!-- UNCOMMENT TO ADD MORE RESOURCES
      <css path="css/NewModal.css" order="1" />
      <resx path="strings/NewModal.1033.resx" version="1.0.0" />
      -->
    </resources>
    <!-- UNCOMMENT TO ENABLE THE SPECIFIED API
    <feature-usage>
      <uses-feature name="Device.captureAudio" required="true" />
      <uses-feature name="Device.captureImage" required="true" />
      <uses-feature name="Device.captureVideo" required="true" />
      <uses-feature name="Device.getBarcodeValue" required="true" />
      <uses-feature name="Device.getCurrentPosition" required="true" />
      <uses-feature name="Device.pickFile" required="true" />
      <uses-feature name="Utility" required="true" />
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
    -->
  </control>
</manifest>
